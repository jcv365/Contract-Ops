<%- include('partials/header', { title: 'Dashboard' }) %>

<h1>Dashboard</h1>

<div class="cards">
  <div class="card">
    <div class="card-value"><%= pendingApprovals %></div>
    <div class="card-label">Pending approvals</div>
    <a href="/portal/approvals">Review &rarr;</a>
  </div>
  <div class="card">
    <div class="card-value"><%= activeSourceCount %> / <%= sourceCount %></div>
    <div class="card-label">Active sources</div>
    <a href="/portal/sources">Manage &rarr;</a>
  </div>
</div>

<h2>Opportunities by status</h2>
<div class="table-region" role="region" aria-label="Dashboard table" tabindex="0">
<table>
  <thead><tr><th>Status</th><th>Count</th></tr></thead>
  <tbody>
    <% byStatus.forEach(function(row) { %>
      <tr><td><%= row.status %></td><td><%= row._count %></td></tr>
    <% }) %>
    <% if (byStatus.length === 0) { %>
      <tr><td colspan="2" class="muted">No opportunities yet — run a HUNT search via the API (<code>POST /hunt/run</code>).</td></tr>
    <% } %>
  </tbody>
</table>
</div>

<%- include('partials/footer') %>
