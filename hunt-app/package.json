{
  "name": "hunt-contract-acquisition-os",
  "version": "1.0.0",
  "description": "HUNT Contract Acquisition OS - Phase 1",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && npm run copy-assets",
    "copy-assets": "node -e \"const fs=require('fs');fs.cpSync('src/portal/views','dist/portal/views',{recursive:true});fs.cpSync('src/portal/public','dist/portal/public',{recursive:true});\"",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:backfill-email-classification": "tsx src/scripts/backfill-email-classification.ts",
    "docker:build": "docker build -t hunt-app .",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "dependencies": {
    "@azure/identity": "^4.4.1",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@prisma/client": "^5.19.0",
    "axios": "^1.7.7",
    "bullmq": "^5.12.0",
    "cheerio": "^1.0.0",
    "connect-redis": "^7.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "express-session": "^1.18.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "js-yaml": "^4.1.0",
    "mammoth": "^1.12.2",
    "multer": "^2.3.0",
    "openai": "^4.57.0",
    "pdf-parse": "^1.1.4",
    "pino": "^9.3.2",
    "pino-pretty": "^11.2.2",
    "prisma": "^5.19.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/js-yaml": "^4.0.9",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.5.0",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.9.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
