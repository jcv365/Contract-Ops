# Copy to .env and fill in. Never commit the real .env (see .gitignore).
# Generated automatically by scripts/generate-secrets.ps1 on the target
# host — do not hand-craft secrets on a dev machine and copy them over.

POSTGRES_PASSWORD=
ENCRYPTION_KEY=
JWT_SECRET=
# Required in production (startup preflight refuses to boot without it) —
# every API route except /health and /portal requires this value in the
# X-API-Key header. Least privilege for programmatic callers.
API_KEY=

# Admin portal (http://<host>:3020/portal) — a human's browser login,
# separate from API_KEY. Required in production.
PORTAL_PASSWORD=
SESSION_SECRET=

# Required before BIDOPS/reply-classification AI calls will succeed —
# without it those specific requests fail closed (422), the server still
# boots and HUNT search/scoring/approval work normally.
FREELLMAPI_API_KEY=

# Optional until an Entra app is registered — Graph send stays on the
# mock transport (ENABLE_GRAPH_SEND=false) without these.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
GRAPH_REDIRECT_URI=

# Safety-critical — leave false until each capability has been reviewed
# and is genuinely ready (ADR-002/ADR-003).
ENABLE_GRAPH_SEND=false
ENABLE_REPLY_INGESTION=false

HOST_PORT=3020
LOG_LEVEL=info
